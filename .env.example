# ==========================================
# RAG 知识库系统 - 环境配置文件 (示例)
# ==========================================

# 项目基础配置
PROJECT_NAME="RAG Knowledge Base"

# ==========================================
# 数据库配置 (PostgreSQL)
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_db

# ==========================================
# 安全配置
# ==========================================
# 请使用命令 `openssl rand -hex 32` 生成一个新的随机字符串填入下方
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==========================================
# LLM 大模型配置
# ==========================================
# 当前使用的提供商：zhipu, openai, claude
LLM_PROVIDER=zhipu

# Agent 模式配置：react, plan, reflect
AGENT_MODE=react

# 智谱 AI 配置
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_MODEL=glm-4-flash

# OpenAI 配置（可选）
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_BASE_URL=https://api.openai.com/v1

# Claude 配置（可选）
CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-3-sonnet-20240229

# ==========================================
# MinIO 对象存储配置
# ==========================================
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_AVATAR_BUCKET=avatars

# ==========================================
# 外部 API 配置
# ==========================================
# 和风天气 API 配置
QWEATHER_API_KEY=your_qweather_api_key_here
QWEATHER_WEATHER_HOST=p449vhnyrb.re.qweatherapi.com
QWEATHER_GEO_HOST=p449vhnyrb.re.qweatherapi.com

# 高德地图 API 配置
GAODE_API_KEY=your_gaode_api_key_here

# Tavily 搜索 API 配置
TAVILY_API_KEY=your_tavily_api_key_here

# ==========================================
# Redis 配置
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ==========================================
# 短信服务配置 (阿里云)
# ==========================================
ALIYUN_ACCESS_KEY_ID=your_aliyun_access_key_id_here
ALIYUN_ACCESS_KEY_SECRET=your_aliyun_access_key_secret_here
ALIYUN_SMS_SIGN_NAME=your_sms_sign_name_here
ALIYUN_SMS_TEMPLATE_CODE=your_sms_template_code_here

# 验证码配置
SMS_CODE_LENGTH=6
SMS_CODE_EXPIRE=300
SMS_SEND_INTERVAL=3600
SMS_DAILY_LIMIT=2

# ==========================================
# 配置说明
# ==========================================
# 1. 请将 "your_xxx_here" 替换为你的实际配置值
# 2. SECRET_KEY 必须是至少32个字符的随机字符串
# 3. 数据库密码请使用你的实际 PostgreSQL 密码
# 4. API Key 请从对应服务商获取
# 5. 不使用的服务可以保留空值，但不要删除配置项