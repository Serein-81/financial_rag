# ==========================
# 1. 绝对不能提交的敏感信息
# ==========================
.env
.env.*
*.log

# ==========================
# 2. Python 编译产生的垃圾文件
# ==========================
__pycache__/
*.py[cod]
*$py.class

# ==========================
# 3. 虚拟环境 (体积巨大，不需要提交)
# ==========================
# 包含了你安装的所有 pip 包，别人应该通过 requirements.txt 自己装
venv/
.venv/
env/
.env/

# ==========================
# 4. IDE 产生的配置文件 (个人配置，不需要共享)
# ==========================
.idea/
.vscode/
*.swp
*.swo

# ==========================
# 5. 操作系统产生的文件
# ==========================
.DS_Store
Thumbs.db