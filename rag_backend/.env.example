# ==========================================
# RAG 知识库系统 - 后端环境变量模板
# ==========================================
# 使用方式：
# 1. 复制本文件为 .env
# 2. 按需填写真实配置
# 3. 不要把 .env 提交到 Git
#
# 标记说明：
# [必填] 本地启动或核心功能必须填写
# [可选] 不使用对应功能时可以留空或保留默认值
# [推荐] 建议配置，尤其是生产环境
#
# 安全提醒：
# - 本文件只放占位值，不要写入真实 API Key、密码、Token
# - SECRET_KEY 建议使用 32 位以上随机字符串
# - 生产环境请替换所有 your_* / change_me_* 占位值

# ==========================================
# 项目基础配置
# ==========================================
# [可选] 项目名称，用于 API 文档和日志展示
PROJECT_NAME="RAG Knowledge Base"

# ==========================================
# PostgreSQL 数据库配置
# ==========================================
# [必填] PostgreSQL 用户名
POSTGRES_USER=postgres
# [必填] PostgreSQL 密码
POSTGRES_PASSWORD=change_me_postgres_password
# [必填] PostgreSQL 地址；本地直连常用 localhost，Docker Compose 内部常用 db
POSTGRES_SERVER=localhost
# [必填] PostgreSQL 端口
POSTGRES_PORT=5432
# [必填] 数据库名称
POSTGRES_DB=rag_db

# ==========================================
# PgBouncer 连接池配置
# ==========================================
# [可选] 是否启用 PgBouncer；生产环境或高并发场景推荐 true
PGBOUNCER_ENABLED=false
# [可选] PgBouncer 主机；Docker Compose 内部常用 pgbouncer
PGBOUNCER_HOST=pgbouncer
# [可选] PgBouncer 容器内部端口通常是 5432，本机映射端口可能是 6432
PGBOUNCER_PORT=5432
# [可选] 连接池模式：transaction 或 session
PGBOUNCER_POOL_MODE=transaction
# [可选] 留空时默认使用 POSTGRES_USER
PGBOUNCER_USER=
# [可选] 留空时默认使用 POSTGRES_PASSWORD
PGBOUNCER_PASSWORD=
# [可选] 留空时默认使用 POSTGRES_DB
PGBOUNCER_DATABASE=

# ==========================================
# 数据库连接池配置
# ==========================================
# [可选] SQLAlchemy 基础连接数；PgBouncer 模式下可以设小一些
DB_POOL_SIZE=5
# [可选] 最大溢出连接数
DB_MAX_OVERFLOW=5
# [可选] 连接获取超时，单位秒
DB_POOL_TIMEOUT=30
# [可选] 连接回收时间，单位秒
DB_POOL_RECYCLE=3600

# ==========================================
# 认证与安全配置
# ==========================================
# [必填] JWT 密钥；至少 32 位随机字符串
SECRET_KEY=change_me_at_least_32_random_characters
# [可选] JWT 算法
ALGORITHM=HS256
# [可选] Token 过期时间，单位分钟
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==========================================
# LLM 大模型基础配置
# ==========================================
# [必填] 默认 LLM 提供商：deepseek, qwen, zhipu, gpt, openai, claude, minimax, xinference, huggingface, modelscope, baichuan
LLM_PROVIDER=deepseek
# [可选] 默认智能体 LLM；留空时使用 LLM_PROVIDER
LLM_PROVIDER_DEFAULT=
# [可选] 专家智能体 LLM；留空时使用 LLM_PROVIDER_DEFAULT 或 LLM_PROVIDER
LLM_PROVIDER_SPECIALIST=
# [可选] Agent 模式：react, plan, reflect
AGENT_MODE=react
# [可选] LLM 通用重试次数
LLM_MAX_RETRIES=5
# [可选] LLM 重试基础延迟，单位秒
LLM_BASE_DELAY=2.0
# [可选] LLM 请求超时，单位秒
LLM_TIMEOUT_SECONDS=600

# ==========================================
# OpenRouter / GPT 配置
# ==========================================
# [按需必填] LLM_PROVIDER=gpt 或通过 OpenRouter 调模型时填写
GPT_API_KEY=your_openrouter_api_key
# [可选] GPT/OpenRouter 模型名
GPT_MODEL=openai/gpt-5.4-nano
# [可选] OpenRouter API 地址
GPT_BASE_URL=https://openrouter.ai/api/v1
# [可选] 是否校验证书；生产环境建议 true
GPT_VERIFY_SSL=true

# ==========================================
# DeepSeek 配置
# ==========================================
# [按需必填] LLM_PROVIDER=deepseek 时填写；也可与 GPT_API_KEY 使用同一个 OpenRouter Key
DEEPSEEK_API_KEY=your_deepseek_or_openrouter_api_key
# [可选] DeepSeek 模型名
DEEPSEEK_MODEL=deepseek/deepseek-chat-v3-0324
# [可选] DeepSeek API 地址
DEEPSEEK_BASE_URL=https://openrouter.ai/api/v1
# [可选] 是否校验证书
DEEPSEEK_VERIFY_SSL=false

# ==========================================
# Qwen 配置
# ==========================================
# [按需必填] LLM_PROVIDER=qwen 时填写；也可与 GPT_API_KEY 使用同一个 OpenRouter Key
QWEN_API_KEY=your_qwen_or_openrouter_api_key
# [可选] Qwen 模型名
QWEN_MODEL=qwen/qwen3.6-plus:free
# [可选] Qwen API 地址
QWEN_BASE_URL=https://openrouter.ai/api/v1
# [可选] 是否校验证书
QWEN_VERIFY_SSL=false

# ==========================================
# 智谱 AI 配置
# ==========================================
# [按需必填] LLM_PROVIDER=zhipu 或 EMBEDDING_PROVIDER=zhipu 时填写
ZHIPU_API_KEY=your_zhipu_api_key
# [可选] 智谱对话模型
ZHIPU_MODEL=glm-4-flash
# [可选] 智谱 Embedding 模型
ZHIPU_EMBEDDING_MODEL=embedding-3

# ==========================================
# OpenAI 配置
# ==========================================
# [按需必填] LLM_PROVIDER=openai 或 EMBEDDING_PROVIDER=openai 时填写
OPENAI_API_KEY=your_openai_api_key
# [可选] OpenAI 对话模型
OPENAI_MODEL=gpt-4
# [可选] OpenAI API 地址
OPENAI_BASE_URL=https://api.openai.com/v1
# [可选] OpenAI Embedding 模型
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ==========================================
# Claude 配置
# ==========================================
# [按需必填] LLM_PROVIDER=claude 时填写
CLAUDE_API_KEY=your_claude_api_key
# [可选] Claude 模型
CLAUDE_MODEL=claude-3-sonnet-20240229
# [可选] Claude API 地址
CLAUDE_BASE_URL=https://api.anthropic.com/v1

# ==========================================
# MiniMax 配置
# ==========================================
# [按需必填] LLM_PROVIDER=minimax 时填写
MINIMAX_API_KEY=your_minimax_api_key
# [可选] MiniMax 模型
MINIMAX_MODEL=MiniMax-Text-01
# [可选] MiniMax API 地址
MINIMAX_BASE_URL=https://api.minimax.chat/v1
# [可选] MiniMax Group ID；平台需要时填写
MINIMAX_GROUP_ID=

# ==========================================
# 其他 LLM 提供商配置
# ==========================================
# [可选] Xinference 本地模型配置
XINFERENCE_API_KEY=
XINFERENCE_MODEL=
XINFERENCE_BASE_URL=http://127.0.0.1:9997/v1

# [可选] HuggingFace 配置
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct
HUGGINGFACE_BASE_URL=https://api-inference.huggingface.co/models

# [可选] ModelScope 魔塔配置
MODELSCOPE_API_KEY=
MODELSCOPE_MODEL=Qwen/Qwen2.5-7B-Instruct
MODELSCOPE_BASE_URL=https://api.modelscope.cn/v1

# [可选] 百川配置
BAICHUAN_API_KEY=
BAICHUAN_MODEL=baichuan4
BAICHUAN_BASE_URL=https://api.baichuan-ai.com/v1
BAICHUAN_SECRET_KEY=

# ==========================================
# Embedding 与 Rerank 配置
# ==========================================
# [必填] 向量化提供商：zhipu, openai, ollama, siliconflow
EMBEDDING_PROVIDER=siliconflow
# [可选] 批量向量化大小
EMBEDDING_BATCH_SIZE=16
# [可选] 向量化最大重试次数
EMBEDDING_MAX_RETRIES=3
# [可选] 向量化请求超时，单位秒
EMBEDDING_TIMEOUT=60

# [按需必填] EMBEDDING_PROVIDER=siliconflow 或启用 rerank 时填写
SILICONFLOW_API_KEY=your_siliconflow_api_key
# [可选] 硅基流动 Embedding 模型
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
# [可选] 硅基流动 Rerank 模型
SILICONFLOW_RERANK_MODEL=Pro/BAAI/bge-reranker-v2-m3
# [可选] 是否启用 rerank
ENABLE_RERANK=true
# [可选] 进入 rerank 的候选数量
RERANK_TOP_K=10
# [可选] 单条文档送入 rerank 的最大字符数
RERANK_MAX_CHARS=512
# [可选] rerank 分数阈值
RERANK_SCORE_THRESHOLD=0.5

# [可选] Ollama 本地 Embedding 配置
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434

# ==========================================
# MinIO 对象存储
# ==========================================
# [必填] MinIO 内部访问地址；Docker Compose 内部常用 minio:9000
MINIO_ENDPOINT=127.0.0.1:9000
# [可选] 浏览器或外部访问地址
MINIO_PUBLIC_ENDPOINT=127.0.0.1:9000
# [必填] MinIO Access Key
MINIO_ACCESS_KEY=minioadmin
# [必填] MinIO Secret Key；生产环境请修改默认值
MINIO_SECRET_KEY=change_me_minio_secret_key
# [可选] 是否使用 HTTPS
MINIO_SECURE=false
# [可选] 文档桶名称
MINIO_BUCKET=documents
# [可选] 头像桶名称
MINIO_AVATAR_BUCKET=avatars
# [可选] 对象存储路径前缀；不需要时留空
MINIO_PREFIX_PATH=
# [可选] 增强模块默认桶；不需要时留空
MINIO_DEFAULT_BUCKET=
# [可选] 是否校验 SSL 证书
MINIO_VERIFY_SSL=true
# [可选] MinIO 最大重试次数
MINIO_RETRY_MAX_ATTEMPTS=3
# [可选] MinIO 初始重试延迟，单位秒
MINIO_RETRY_DELAY=1.0
# [可选] 是否使用指数退避
MINIO_RETRY_EXPONENTIAL=true

# ==========================================
# 文档解析 / OCR 配置
# ==========================================
# [可选] 是否启用 Unstructured 重型版面解析；true 时 Docker Compose 需使用 --profile heavy 或 --profile full
ENABLE_UNSTRUCTURED_PARSER=false
# [可选] Unstructured API 地址
UNSTRUCTURED_API_URL=http://unstructured-api:8000
# [可选] OCR 引擎：paddleocr, tesseract, unstructured, siliconflow_vlm
OCR_ENGINE=siliconflow_vlm
# [可选] PaddleOCR API 地址；不使用 PaddleOCR 可留默认
PADDLEOCR_API_URL=http://paddleocr-api:8866/predict/ocr_system
# [可选] PaddleOCR 算法
PADDLEOCR_ALGORITHM=PaddleOCR-VL
# [可选] MinerU API Server；不用 MinerU 可留空
MINERU_APISERVER=
# [可选] MinerU 输出目录
MINERU_OUTPUT_DIR=/tmp/mineru_output
# [可选] MinerU 后端：pipeline 或 api 等
MINERU_BACKEND=pipeline
# [可选] MinerU 服务 URL；不用远程服务可留空
MINERU_SERVER_URL=
# [可选] 是否处理后删除 MinerU 输出，1 表示删除
MINERU_DELETE_OUTPUT=1

# ==========================================
# 外部 API
# ==========================================
# [可选] 和风天气 API Key；不用天气功能可留空
QWEATHER_API_KEY=
# [可选] 和风天气查询 Host；按账号控制台配置填写
QWEATHER_WEATHER_HOST=
# [可选] 和风地理位置 Host；按账号控制台配置填写
QWEATHER_GEO_HOST=
# [可选] 高德地图 API Key；不用位置功能可留空
GAODE_API_KEY=
# [可选] Tavily 搜索 API Key；不用 Web 搜索增强可留空
TAVILY_API_KEY=

# ==========================================
# 政策采集配置
# ==========================================
# [可选] 是否启用在线政策采集；默认关闭，避免未确认 robots/频率要求前自动访问公网
POLICY_ONLINE_CRAWL_ENABLED=false
# [可选] 在线采集不可用时是否使用样例数据
POLICY_SAMPLE_FALLBACK_ENABLED=true
# [推荐] 是否要求必须能获取并确认 robots.txt；true 时无法确认 robots 会跳过在线采集
POLICY_REQUIRE_ROBOTS_TXT=true
# [推荐] 合规采集 User-Agent；请替换为能联系到系统负责人的真实联系方式
POLICY_COLLECTOR_USER_AGENT="PolicyCollector/1.0 (Enterprise Tax System; Contact: support@example.com)"

# ==========================================
# Redis 配置
# ==========================================
# [必填] Redis 主机；Docker Compose 内部常用 redis
REDIS_HOST=localhost
# [必填] Redis 端口
REDIS_PORT=6379
# [可选] Redis DB 编号
REDIS_DB=0
# [可选] Redis 密码；如果 Redis 没有密码可留空
REDIS_PASSWORD=

# ==========================================
# 缓存、批处理与限流
# ==========================================
# [可选] 是否启用记忆缓存
ENABLE_MEMORY_CACHE=true
# [可选] 批处理最大并发
BATCH_MAX_CONCURRENCY=10
# [可选] 是否开启批处理进度 WebSocket
BATCH_PROGRESS_WS_ENABLED=true
# [可选] 是否启用 API 限流
RATE_LIMIT_ENABLED=true
# [可选] 每分钟请求限制
RATE_LIMIT_REQUESTS_PER_MINUTE=60
# [可选] 每小时请求限制
RATE_LIMIT_REQUESTS_PER_HOUR=1000
# [可选] 突发请求容量
RATE_LIMIT_BURST_SIZE=10
# [可选] 限流策略：sliding_window, token_bucket, fixed_window
RATE_LIMIT_STRATEGY=sliding_window
# [可选] 限流存储：memory, redis
RATE_LIMIT_STORAGE=memory
# [可选] 记忆缓存 TTL，单位秒
MEMORY_CACHE_TTL=1800
# [可选] 记忆缓存 key 前缀
MEMORY_CACHE_PREFIX=memory:

# ==========================================
# 智能存储调度
# ==========================================
# [可选] 是否启用冷热分层存储
ENABLE_STORAGE_TIERING=false
# [可选] 热数据阈值
HOT_THRESHOLD=10
# [可选] 冷数据阈值
COLD_THRESHOLD=2
# [可选] 热数据 TTL，单位秒
HOT_TTL=3600
# [可选] 冷数据批处理大小
COLD_BATCH_SIZE=50

# ==========================================
# 阿里云短信服务
# ==========================================
# [可选] 不使用短信登录/验证码时可全部留空
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
# [可选] 验证码长度
SMS_CODE_LENGTH=6
# [可选] 验证码过期时间，单位秒
SMS_CODE_EXPIRE=300
# [可选] 同一用户发送间隔，单位秒
SMS_SEND_INTERVAL=3600
# [可选] 每日发送限制
SMS_DAILY_LIMIT=3

# ==========================================
# 知识图谱配置
# ==========================================
# [可选] 是否启用知识图谱
ENABLE_KNOWLEDGE_GRAPH=false
# [可选] 是否启用实体提取
ENABLE_ENTITY_EXTRACTION=false
# [可选] 是否启用关系提取
ENABLE_RELATION_EXTRACTION=false
# [可选] 是否启用指代消解
ENABLE_COREFERENCE_RESOLUTION=true
# [可选] 实体置信度阈值
ENTITY_CONFIDENCE_THRESHOLD=0.7
# [可选] 实体提取方式：llm 或 spacy
ENTITY_EXTRACTION_METHOD=llm
# [可选] 实体提取模型
ENTITY_EXTRACTION_MODEL=glm-4-flash

# [启用知识图谱时必填] Neo4j 连接地址；Docker Compose 内部常用 bolt://neo4j:7687
NEO4J_URI=bolt://localhost:7687
# [启用知识图谱时必填] Neo4j 用户名
NEO4J_USER=neo4j
# [启用知识图谱时必填] Neo4j 密码
NEO4J_PASSWORD=change_me_neo4j_password
# [可选] Neo4j 数据库名
NEO4J_DATABASE=neo4j

# [可选] 知识图谱实体/关系提取模型
KG_EXTRACTION_MODEL=deepseek/deepseek-chat
# [可选] 提取重试次数
EXTRACTION_MAX_RETRIES=1
# [可选] 提取并发数
EXTRACTION_CONCURRENCY=3

# ==========================================
# 搜索增强配置
# ==========================================
# [可选] 是否启用查询改写
ENABLE_QUERY_REWRITE=true
# [可选] 是否启用 HyDE
ENABLE_HYDE=false
# [可选] 是否启用 MMR 重排序
ENABLE_MMR=true
# [可选] 是否启用混合检索
ENABLE_HYBRID_RETRIEVAL=true
# [可选] 向量检索权重，0.0-1.0
VECTOR_RETRIEVAL_WEIGHT=0.7
# [可选] 图检索权重，0.0-1.0
GRAPH_RETRIEVAL_WEIGHT=0.3
# [可选] 是否启用意图检测
ENABLE_INTENT_DETECTION=true
# [可选] 查询扩展数量
QUERY_EXPANSION_COUNT=2
# [可选] MMR 系数，0.0-1.0
MMR_LAMBDA=0.6
# [可选] 默认返回结果数量
DEFAULT_TOP_K=5
# [可选] 相似度阈值
SIMILARITY_THRESHOLD=0.3
# [可选] 最大上下文长度
MAX_CONTEXT_LENGTH=8000

# ==========================================
# 记忆系统配置
# ==========================================
# [可选] 是否启用记忆系统
ENABLE_MEMORY_SYSTEM=true
# [可选] 工作记忆大小
WORKING_MEMORY_SIZE=7
# [可选] 情景记忆大小
EPISODIC_MEMORY_SIZE=100
# [可选] 语义记忆大小
SEMANTIC_MEMORY_SIZE=1000
# [可选] 是否启用记忆衰减
ENABLE_MEMORY_DECAY=true
# [可选] 是否启用记忆整合
ENABLE_MEMORY_CONSOLIDATION=true

# ==========================================
# 性能优化配置
# ==========================================
# [可选] 是否启用向量缓存
ENABLE_VECTOR_CACHE=true
# [可选] 是否启用结果缓存
ENABLE_RESULT_CACHE=true
# [可选] 缓存过期时间，单位秒
CACHE_EXPIRE_TIME=3600
# [可选] 是否启用批处理
ENABLE_BATCH_PROCESSING=true

# ==========================================
# MCP 远程工具服务配置
# ==========================================
# [可选] 工具来源模式：cloud（云端 MCP）、local（本地工具）、auto（自动选择/同时注册）
MCP_MODE=cloud
# [可选] 本地 MCP 服务地址；不用本地 MCP 可留默认
MCP_LOCAL_URL=http://127.0.0.1:8001
# [可选] 本地 MCP API Key；不启用鉴权可留空
MCP_LOCAL_API_KEY=
# [可选] 云端 MCP 服务地址；使用云端工具时填写
MCP_SERVER_URL=http://your-mcp-server:8080
# [可选] 云端 MCP API Key；服务开启鉴权时填写
MCP_API_KEY=
# [可选] MCP 请求超时，单位秒
MCP_TIMEOUT=120

# ==========================================
# LangSmith 追踪配置
# ==========================================
# [可选] 是否启用 LangSmith 追踪
LANGSMITH_TRACING=false
# [可选] LangSmith API Key；不开启追踪可留空
LANGSMITH_API_KEY=
# [可选] LangSmith 项目名称
LANGSMITH_PROJECT=financial_rag
# [可选] LangSmith Endpoint
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# [可选] 是否启用本项目的 LangSmith 集成逻辑
LANGSMITH_INTEGRATION_ENABLED=true

# ==========================================
# A2A 多智能体通信配置
# ==========================================
# [可选] A2A 传输模式：graph_state, http, local
A2A_TRANSPORT_MODE=graph_state
# [可选] A2A_TRANSPORT_MODE=http 时使用
A2A_HTTP_BASE_URL=http://localhost:8000
# [可选] A2A HTTP 超时，单位秒
A2A_HTTP_TIMEOUT=30.0
# [可选] A2A HTTP 重试次数
A2A_HTTP_RETRY_TIMES=3
