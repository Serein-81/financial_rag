# ==========================================
# RAG 知识库系统 - 环境配置文件模板
# ==========================================

# 项目基础配置
PROJECT_NAME="RAG Knowledge Base"

# ==========================================
# 数据库配置 (PostgreSQL)
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_db

# ==========================================
# 安全配置
# ==========================================
SECRET_KEY=your-secret-key-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==========================================
# LLM 大模型配置
# ==========================================
LLM_PROVIDER=zhipu
AGENT_MODE=react

# 智谱 AI
ZHIPU_API_KEY=your_zhipu_api_key
ZHIPU_MODEL=glm-4-flash

# OpenAI (可选)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4
OPENAI_BASE_URL=https://api.openai.com/v1

# MiniMax (可选)
MINIMAX_API_KEY=your_minimax_api_key
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_GROUP_ID=your_group_id

# Claude (可选)
CLAUDE_API_KEY=your_claude_api_key
CLAUDE_MODEL=claude-3-sonnet-20240229

# ==========================================
# MinIO 对象存储
# ==========================================
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_PUBLIC_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=documents
MINIO_AVATAR_BUCKET=avatars

# ==========================================
# 外部 API
# ==========================================
QWEATHER_API_KEY=your_qweather_api_key
QWEATHER_WEATHER_HOST=your_host
QWEATHER_GEO_HOST=your_host
GAODE_API_KEY=your_gaode_api_key
TAVILY_API_KEY=your_tavily_api_key

# ==========================================
# Redis
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ==========================================
# 短信服务 (阿里云)
# ==========================================
ALIYUN_ACCESS_KEY_ID=your_access_key_id
ALIYUN_ACCESS_KEY_SECRET=your_access_key_secret
ALIYUN_SMS_SIGN_NAME=签名
ALIYUN_SMS_TEMPLATE_CODE=SMS_xxx
SMS_CODE_LENGTH=6
SMS_CODE_EXPIRE=300
SMS_SEND_INTERVAL=3600
SMS_DAILY_LIMIT=2

# ==========================================
# Embedding 向量化
# ==========================================
EMBEDDING_PROVIDER=siliconflow
SILICONFLOW_API_KEY=your_siliconflow_api_key
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3

# ==========================================
# 知识图谱
# ==========================================
ENABLE_KNOWLEDGE_GRAPH=true
ENABLE_ENTITY_EXTRACTION=true
ENABLE_RELATION_EXTRACTION=true
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=neo4j
ENTITY_EXTRACTION_METHOD=llm
ENTITY_EXTRACTION_MODEL=glm-4-flash

# ==========================================
# 搜索增强开关
# ==========================================
ENABLE_QUERY_REWRITE=true
ENABLE_HYDE=false
ENABLE_MMR=true
ENABLE_HYBRID_RETRIEVAL=true
VECTOR_RETRIEVAL_WEIGHT=0.7
GRAPH_RETRIEVAL_WEIGHT=0.3
ENABLE_INTENT_DETECTION=true
QUERY_EXPANSION_COUNT=2
MMR_LAMBDA=0.6
DEFAULT_TOP_K=5
SIMILARITY_THRESHOLD=0.3
MAX_CONTEXT_LENGTH=8000

# ==========================================
# 记忆系统开关
# ==========================================
ENABLE_MEMORY_SYSTEM=true
WORKING_MEMORY_SIZE=7
EPISODIC_MEMORY_SIZE=100
SEMANTIC_MEMORY_SIZE=1000
ENABLE_MEMORY_DECAY=true
ENABLE_MEMORY_CONSOLIDATION=true

# ==========================================
# 性能优化开关
# ==========================================
ENABLE_VECTOR_CACHE=true
ENABLE_RESULT_CACHE=true
CACHE_EXPIRE_TIME=3600
ENABLE_BATCH_PROCESSING=true

# ==========================================
# MCP 远程工具服务
# ==========================================
MCP_MODE=cloud
MCP_LOCAL_URL=http://127.0.0.1:8001
MCP_LOCAL_API_KEY=
MCP_SERVER_URL=http://your-server:8080
MCP_API_KEY=your_mcp_api_key
MCP_TIMEOUT=120

# ==========================================
# LangSmith 追踪配置
# ==========================================
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=financial_rag
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_INTEGRATION_ENABLED=true
