# ========================================
# Embedding 向量化配置
# ========================================
# 当前使用的提供商：zhipu, openai, ollama, siliconflow
EMBEDDING_PROVIDER=zhipu

# 通用 Embedding 配置
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_RETRIES=3
EMBEDDING_TIMEOUT=60

# 智谱 AI Embedding 配置（默认）
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_EMBEDDING_MODEL=embedding-3

# OpenAI Embedding 配置（可选）
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama 本地部署配置（可选）
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434

# 硅基流动配置（可选）
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3

# ========================================
# 知识图谱增强配置
# ========================================
# 启用知识图谱功能
ENABLE_KNOWLEDGE_GRAPH=True
ENABLE_ENTITY_EXTRACTION=True
ENABLE_RELATION_EXTRACTION=True

# 新增：指代消解（处理代词问题）
ENABLE_COREFERENCE_RESOLUTION=True

# 新增：实体置信度阈值（0-1，推荐 0.7）
# 低于此阈值的实体将被过滤
ENTITY_CONFIDENCE_THRESHOLD=0.7

# Neo4j 配置
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password
NEO4J_DATABASE=neo4j

# ========================================
# OCR引擎配置
# ========================================
# OCR引擎选择 (可选值: mineru, paddleocr, tesseract, 留空则自动选择最优)
OCR_ENGINE=

# MinerU 配置 (推荐用于复杂PDF)
# MINERU_APISERVER: MinerU API服务器地址
# MINERU_BACKEND: pipeline / vlm / RapidVLE
# MINERU_SERVER_URL: 远程服务器URL (用于服务器模式)
MINERU_APISERVER=
MINERU_OUTPUT_DIR=/tmp/mineru_output
MINERU_BACKEND=pipeline
MINERU_SERVER_URL=
MINERU_DELETE_OUTPUT=1

# PaddleOCR 配置
# PADDLEOCR_API_URL: 远程API地址 (可选，用于API模式)
# PADDLEOCR_ALGORITHM: PaddleOCR-VL / PP-OCRv4
PADDLEOCR_API_URL=
PADDLEOCR_ALGORITHM=PaddleOCR-VL
PADDLEOCR_ACCESS_TOKEN=

# ========================================
# LangSmith 追踪配置
# ========================================
# 启用 LangSmith 追踪
LANGSMITH_TRACING=true

# LangSmith API 端点
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# LangSmith API Key
LANGSMITH_API_KEY=

# LangSmith 项目名称
LANGSMITH_PROJECT=financial_rag

# ========================================
# MCP 远程工具服务配置
# ========================================
# MCP 服务器地址（包含 /sse 路径）
MCP_SERVER_URL=http://8.148.226.49:8080/sse

# MCP API 密钥
MCP_API_KEY=

# MCP 连接超时时间（秒）
MCP_TIMEOUT=120
