# ==========================================
# RAG 知识库系统 - 环境配置文件模板
# ==========================================
# 配置说明：
# [必填] - 必须填写配置项，否则系统无法正常运行
# [可选] - 可以使用默认值，也可以根据需要修改
# 注意：请复制此文件为 .env，然后填写实际配置值

# ==========================================
# 项目基础配置
# ==========================================
PROJECT_NAME="RAG Knowledge Base"

# ==========================================
# 数据库配置 (PostgreSQL)
# ==========================================
# [必填] PostgreSQL 用户名
POSTGRES_USER=postgres
# [必填] PostgreSQL 密码
POSTGRES_PASSWORD=your_postgres_password
# [必填] PostgreSQL 服务器地址
POSTGRES_SERVER=localhost
# [可选] PostgreSQL 端口（默认：5432）
POSTGRES_PORT=5432
# [可选] 数据库名称（默认：rag_db）
POSTGRES_DB=rag_db

# ==========================================
# PgBouncer 配置 (可选 - 生产环境推荐使用)
# ==========================================
# [可选] 是否启用 PgBouncer 连接池（默认：false）
PGBOUNCER_ENABLED=false
# PgBouncer 主机（Docker Compose 环境中填写服务名）
PGBOUNCER_HOST=pgbouncer
# PgBouncer 端口（容器内部端口映射）
PGBOUNCER_PORT=5432
# PgBouncer 连接池模式：transaction 或 session
# 推荐使用 transaction 模式（性能更好）
PGBOUNCER_POOL_MODE=transaction

# ==========================================
# 数据库连接池配置（PgBouncer 模式下建议值）
# ==========================================
# 基础连接数（PgBouncer 模式下可以设小一些）
DB_POOL_SIZE=5
# 最大溢出连接数
DB_MAX_OVERFLOW=5
# 连接获取超时（秒）
DB_POOL_TIMEOUT=30
# 连接回收时间（秒）
DB_POOL_RECYCLE=3600

# ==========================================
# 安全配置
# ==========================================
# [必填] JWT 密钥（至少32位字符，建议使用随机字符串）
SECRET_KEY=your-secret-key-at-least-32-characters
# [可选] JWT 算法（默认：HS256）
ALGORITHM=HS256
# [可选] Token 过期时间（分钟，默认：1440）
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==========================================
# LLM 大模型配置
# ==========================================
# [必填] LLM 提供商选择：deepseek, qwen, zhipu, gpt, openai, claude, minimax
LLM_PROVIDER=deepseek

# 默认智能体 LLM 配置（问候语、普通对话等）
# 为空时使用 LLM_PROVIDER 的值
LLM_PROVIDER_DEFAULT=deepseek

# 专家智能体 LLM 配置（金融、税务、法律等专家）
# 为空时所有智能体都使用 LLM_PROVIDER 的值
# 可选：deepseek, qwen, zhipu, gpt, openai, claude, minimax 等
LLM_PROVIDER_SPECIALIST=qwen

# [可选] Agent 模式：react, plan, act
AGENT_MODE=react

# ==========================================
# OpenRouter API 配置 (GPT/DeepSeek/Qwen 共用)
# ==========================================
# [必填] OpenRouter API Key
GPT_API_KEY=sk-or-v1-your-openrouter-api-key
# [可选] 模型名称
GPT_MODEL=openai/gpt-5.4-nano
# [可选] API 基础地址
GPT_BASE_URL=https://openrouter.ai/api/v1
# [可选] 是否验证 SSL（生产环境建议 true）
GPT_VERIFY_SSL=false

# DeepSeek 配置（使用 OpenRouter API）
# [可选] DeepSeek API Key（可共用 GPT_API_KEY）
DEEPSEEK_API_KEY=sk-or-v1-your-openrouter-api-key
# [可选] DeepSeek 模型
DEEPSEEK_MODEL=deepseek/deepseek-chat-v3-0324
# [可选] DeepSeek API 地址
DEEPSEEK_BASE_URL=https://openrouter.ai/api/v1
# [可选] 是否验证 SSL
DEEPSEEK_VERIFY_SSL=false

# Qwen 配置（使用 OpenRouter API）
# [可选] Qwen API Key（可共用 GPT_API_KEY）
QWEN_API_KEY=sk-or-v1-your-openrouter-api-key
# [可选] Qwen 模型
QWEN_MODEL=qwen/qwen3.6-plus:free
# [可选] Qwen API 地址
QWEN_BASE_URL=https://openrouter.ai/api/v1
# [可选] 是否验证 SSL
QWEN_VERIFY_SSL=false

# ==========================================
# 智谱 AI 配置
# ==========================================
# [必填] 智谱 AI API Key
ZHIPU_API_KEY=your_zhipu_api_key
# [可选] 智谱模型（默认：glm-4-flash）
ZHIPU_MODEL=glm-4-flash

# ==========================================
# OpenAI 配置 (可选)
# ==========================================
# [可选] OpenAI API Key
OPENAI_API_KEY=your_openai_api_key
# [可选] OpenAI 模型
OPENAI_MODEL=gpt-4
# [可选] OpenAI API 地址
OPENAI_BASE_URL=https://api.openai.com/v1

# ==========================================
# MiniMax 配置
# ==========================================
# [可选] MiniMax API Key
MINIMAX_API_KEY=your_minimax_api_key
# [可选] MiniMax 模型
MINIMAX_MODEL=MiniMax-M2.7
# [可选] MiniMax API 地址
MINIMAX_BASE_URL=https://api.minimax.chat/v1
# [可选] MiniMax Group ID
MINIMAX_GROUP_ID=your_group_id

# ==========================================
# Claude 配置 (可选)
# ==========================================
# [可选] Claude API Key
CLAUDE_API_KEY=your_claude_api_key
# [可选] Claude 模型
CLAUDE_MODEL=claude-3-sonnet-20240229

# ==========================================
# MinIO 对象存储
# ==========================================
# [必填] MinIO 端点地址
MINIO_ENDPOINT=127.0.0.1:9000
# [可选] MinIO 公共端点（用于文件访问）
MINIO_PUBLIC_ENDPOINT=127.0.0.1:9000
# [必填] MinIO Access Key
MINIO_ACCESS_KEY=minioadmin
# [必填] MinIO Secret Key
MINIO_SECRET_KEY=minioadmin
# [可选] 是否启用 HTTPS（默认：false）
MINIO_SECURE=false
# [可选] 文档存储桶名称（默认：documents）
MINIO_BUCKET=documents
# [可选] 头像存储桶名称（默认：avatars）
MINIO_AVATAR_BUCKET=avatars

# ==========================================
# 外部 API
# ==========================================
# 和风天气 API（可选，用于天气查询功能）
QWEATHER_API_KEY=your_qweather_api_key
QWEATHER_WEATHER_HOST=p449vhnyrb.re.qweatherapi.com
QWEATHER_GEO_HOST=p449vhnyrb.re.qweatherapi.com

# 高德地图 API（可选，用于地理位置功能）
GAODE_API_KEY=your_gaode_api_key

# Tavily 搜索 API（可选，用于增强搜索功能）
TAVILY_API_KEY=your_tavily_api_key

# ==========================================
# Redis 配置
# ==========================================
# [必填] Redis 服务器地址
REDIS_HOST=localhost
# [可选] Redis 端口（默认：6379）
REDIS_PORT=6379
# [可选] Redis 数据库编号（默认：0）
REDIS_DB=0
# [可选] Redis 密码（如果没有设置则留空）
REDIS_PASSWORD=

# ==========================================
# 短信服务 (阿里云) - 可选功能
# ==========================================
# [可选] 阿里云 Access Key ID
ALIYUN_ACCESS_KEY_ID=your_access_key_id
# [可选] 阿里云 Access Key Secret
ALIYUN_ACCESS_KEY_SECRET=your_access_key_secret
# [可选] 短信签名名称
ALIYUN_SMS_SIGN_NAME=签名
# [可选] 短信模板代码
ALIYUN_SMS_TEMPLATE_CODE=SMS_xxx
# [可选] 验证码长度（默认：6）
SMS_CODE_LENGTH=6
# [可选] 验证码过期时间（秒，默认：300）
SMS_CODE_EXPIRE=300
# [可选] 短信发送间隔（秒，默认：3600）
SMS_SEND_INTERVAL=3600
# [可选] 每日发送限制（默认：2）
SMS_DAILY_LIMIT=2

# ==========================================
# Embedding 向量化配置
# ==========================================
# [必填] 向量化提供商选择：zhipu, openai, ollama, siliconflow
EMBEDDING_PROVIDER=siliconflow
# [必填] 硅基流动 API Key（用于免费 Embedding）
SILICONFLOW_API_KEY=your_siliconflow_api_key
# [可选] Embedding 模型（默认：BAAI/bge-m3）
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3

# ==========================================
# 知识图谱配置
# ==========================================
# [可选] 是否启用知识图谱（默认：true）
ENABLE_KNOWLEDGE_GRAPH=true
# [可选] 是否启用实体提取（默认：true）
ENABLE_ENTITY_EXTRACTION=true
# [可选] 是否启用关系提取（默认：true）
ENABLE_RELATION_EXTRACTION=true
# [必填] Neo4j 数据库 URI
NEO4J_URI=bolt://localhost:7687
# [必填] Neo4j 用户名
NEO4J_USER=neo4j
# [必填] Neo4j 密码
NEO4J_PASSWORD=your_neo4j_password
# [可选] Neo4j 数据库名称（默认：neo4j）
NEO4J_DATABASE=neo4j

# 知识图谱提取配置
# [可选] 实体/关系提取模型（默认：deepseek/deepseek-chat）
KG_EXTRACTION_MODEL=deepseek/deepseek-chat
# [可选] 提取重试次数（建议 1-2）
EXTRACTION_MAX_RETRIES=1
# [可选] 提取并发数（建议 3-5）
EXTRACTION_CONCURRENCY=3

# ==========================================
# 搜索增强配置
# ==========================================
# [可选] 是否启用查询改写（默认：true）
ENABLE_QUERY_REWRITE=true
# [可选] 是否启用 HyDE（默认：false）
ENABLE_HYDE=false
# [可选] 是否启用 MMR 重排序（默认：true）
ENABLE_MMR=true
# [可选] 是否启用混合检索（默认：true）
ENABLE_HYBRID_RETRIEVAL=true
# [可选] 向量检索权重（0.0-1.0，默认：0.7）
VECTOR_RETRIEVAL_WEIGHT=0.7
# [可选] 图检索权重（0.0-1.0，默认：0.3）
GRAPH_RETRIEVAL_WEIGHT=0.3
# [可选] 是否启用意图检测（默认：true）
ENABLE_INTENT_DETECTION=true
# [可选] 查询扩展数量（默认：2）
QUERY_EXPANSION_COUNT=2
# [可选] MMR 系数（0.0-1.0，默认：0.6）
MMR_LAMBDA=0.6
# [可选] 默认返回结果数量（默认：5）
DEFAULT_TOP_K=5
# [可选] 相似度阈值（默认：0.3）
SIMILARITY_THRESHOLD=0.3
# [可选] 最大上下文长度（默认：8000）
MAX_CONTEXT_LENGTH=8000

# ==========================================
# 记忆系统配置
# ==========================================
# [可选] 是否启用记忆系统（默认：true）
ENABLE_MEMORY_SYSTEM=true
# [可选] 工作记忆大小（默认：7）
WORKING_MEMORY_SIZE=7
# [可选] 情景记忆大小（默认：100）
EPISODIC_MEMORY_SIZE=100
# [可选] 语义记忆大小（默认：1000）
SEMANTIC_MEMORY_SIZE=1000
# [可选] 是否启用记忆衰减（默认：true）
ENABLE_MEMORY_DECAY=true
# [可选] 是否启用记忆整合（默认：true）
ENABLE_MEMORY_CONSOLIDATION=true

# ==========================================
# 性能优化配置
# ==========================================
# [可选] 是否启用向量缓存（默认：true）
ENABLE_VECTOR_CACHE=true
# [可选] 是否启用结果缓存（默认：true）
ENABLE_RESULT_CACHE=true
# [可选] 缓存过期时间（秒，默认：3600）
CACHE_EXPIRE_TIME=3600
# [可选] 是否启用批处理（默认：true）
ENABLE_BATCH_PROCESSING=true

# ==========================================
# MCP 远程工具服务配置
# ==========================================
# [可选] MCP 工具来源模式：cloud（仅云端）、local（仅本地）、auto（同时注册）
MCP_MODE=cloud
# [可选] 本地 MCP 服务地址
MCP_LOCAL_URL=http://127.0.0.1:8001
# [可选] 本地 MCP API Key
MCP_LOCAL_API_KEY=
# [可选] 云端 MCP 服务地址
MCP_SERVER_URL=http://your-mcp-server:8080
# [可选] 云端 MCP API Key
MCP_API_KEY=your_mcp_api_key
# [可选] MCP 请求超时时间（秒，默认：120）
MCP_TIMEOUT=120

# ==========================================
# LangSmith 追踪配置（可选 - 用于调试和分析）
# ==========================================
# [可选] 是否启用 LangSmith 追踪
LANGSMITH_TRACING=false
# [可选] LangSmith API Key
LANGSMITH_API_KEY=your_langsmith_api_key
# [可选] LangSmith 项目名称
LANGSMITH_PROJECT=financial_rag
# [可选] LangSmith 端点
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# [可选] 是否启用 LangSmith 集成
LANGSMITH_INTEGRATION_ENABLED=true
